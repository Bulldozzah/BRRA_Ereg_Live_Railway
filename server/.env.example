# ---------------------------------------------------------------
# MySQL configuration for the Zambia eRegistry API server
# ---------------------------------------------------------------
# Copy this file to server/.env and fill in real values.
# server/.env is gitignored — never commit real credentials.
#
# PRECEDENCE (see src/db.js): MYSQL_URL wins over MYSQL_PUBLIC_URL,
# which wins over the DB_* / MYSQL* variables below. If MYSQL_URL is
# set, every DB_* value here is ignored.

# --- Local development (XAMPP / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zambiaeregistry

# --- Local development against a remote Railway database ---
# Use the PUBLIC proxy host and port from the Railway dashboard.
# Do NOT use mysql.railway.internal here: that hostname only resolves
# inside Railway's private network and will fail from a local machine.
# Do NOT set MYSQL_URL locally either — Railway's value points at the
# internal host and, per the precedence above, would override DB_*.
# DB_HOST=<your-public-proxy>.proxy.rlwy.net
# DB_PORT=<your-public-proxy-port>
# DB_USER=root
# DB_PASSWORD=<your_password>
# DB_NAME=railway

# --- Deployed on Railway (injected automatically — do not set here) ---
# MYSQL_URL, MYSQL_PUBLIC_URL, MYSQLHOST, MYSQLPORT,
# MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE

# --- Server ---
PORT=3001
CORS_ORIGIN=http://localhost:8080,http://localhost:8081,http://localhost:5173
