# MySQL Database Configuration
# For local development against XAMPP/MariaDB:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zambiaeregistry

# For a remote MySQL instance (e.g. Railway public proxy), use your own values:
# DB_HOST=your-host.proxy.rlwy.net
# DB_PORT=your_port
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=railway

# Railway MySQL (auto-injected by Railway on deployment - do not change)
# MYSQLHOST=mysql.railway.internal
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=your_railway_password
# MYSQLDATABASE=railway

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:8080
